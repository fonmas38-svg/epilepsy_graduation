# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
*.joblib
!backend/models/.gitkeep

# Runtime data stores — NEVER commit. These are generated at runtime and hold
# sensitive data: users_store.json contains hashed account passwords, and
# cloud_store.json contains patient monitoring data. They are recreated on first
# run (an admin is auto-seeded), so excluding them is safe.
backend/data/cloud_store.json
backend/data/users_store.json
backend/data/*_store.json
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
backend/data/*.sqliten
backend/data/*.sqlite3
backend/data/*.pre-sqlite-*.bak

# Large / regenerable dataset binaries (rebuild via research edf_prep / build_dataset)
*.h5

# Node (admin-dashboard) — also covered by admin-dashboard/.gitignore
node_modules/
dist/
.vite/

# Flutter
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/.pub-cache/
mobile/.pub-preload-cache/
mobile/.idea/
mobile/*.iml
mobile/android/.gradle/
mobile/android/.kotlin/
mobile/android/local.properties
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/.firebase/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Secrets
**/google-services.json
**/GoogleService-Info.plist
**/serviceAccountKey.json
**/*firebase-adminsdk*.json
**/*firebase-service-account*.json
**/*service-account-key*.json
firebase_options.dart
!mobile/lib/firebase_options.dart.example

# Agent skills: `.agents/skills/` is the single committed copy. The per-tool
# directories are junctions/symlinks to it created by `npx skills add`, so
# committing them would duplicate every file (or break on other platforms).
.claude/skills/
.augment/
.kiro/
.qwen/
.windsurf/

# ─────────────────────────────────────────────────────────────
# التوثيق والمخططات (Documentation & Diagrams):
# يُرفع إلى GitHub فقط ملفات التوثيق الموجودة في جذر مجلد docs/ (*.md, firestore.rules).
# يُستثنى من الرفع كافة المجلدات الفرعية (المخططات diagrams، كتب التخرج final_book،
# الأدلة guidelines، الأرشيف _archive، وأي مجلد فرعي آخر)،
# وكذلك سكربتات التوليد والملفات المضغوطة ومخرجات Word و PowerPoint.
# ─────────────────────────────────────────────────────────────
docs/*/
docs/*.py
docs/*.zip
docs/*.pptx
docs/*.docx
docs/*.pdf

# Certificates
*.pfx

# Misc
*.log

.coverage
htmlcov/
.pytest_cache/
.pytest_temp/
**/.pytest_temp/
**/__pycache__/

