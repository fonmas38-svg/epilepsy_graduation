# Base URL of the FastAPI backend REST API.
#
# Leave EMPTY to use the Vite dev proxy (recommended for local dev): requests go
# to /api/* and Vite forwards them to VITE_PROXY_TARGET (default 127.0.0.1:8000),
# so the browser makes same-origin calls and CORS is a non-issue.
#
# Set it to an absolute URL when serving the built dashboard against a remote
# backend, e.g. VITE_API_BASE_URL=http://192.168.1.20:8000
VITE_API_BASE_URL=

# Where the dev proxy forwards /api during `npm run dev`.
VITE_PROXY_TARGET=http://127.0.0.1:8000
