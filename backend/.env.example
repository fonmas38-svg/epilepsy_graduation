# Demo profile (local presentation only)
APP_ENV=demo
# Storage: SQLITE_DB_PATH is the local/demo default. Setting DATABASE_URL
# switches the whole backend to PostgreSQL (Supabase or any managed instance)
# and SQLITE_DB_PATH is then ignored.
SQLITE_DB_PATH=./data/epilepsy.db
# Never commit a real value: keep it in the server secret store only.
# Direct connection (needs IPv6 support on the host):
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres?sslmode=require
# Supabase/Supavisor session pooler (the user carries the tenant id after a dot,
# and the password must be percent-encoded if it contains @ : / ? # or %):
# DATABASE_URL=postgresql://postgres.POOLER_TENANT_ID:PASSWORD@HOST:5432/postgres?sslmode=require
# Pool sizing must stay inside the plan's connection limit:
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE_SECONDS=1800
# Run migrations as a single deploy step instead of on every worker start:
# RUN_MIGRATIONS_ON_STARTUP=0
# This file is parsed as KEY=VALUE: paste only the connection string into
# DATABASE_URL, never the surrounding prose from the hosting panel. The full
# Supabase procedure lives in docs/supabase-migration-ar.md.

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-before-first-start
ADMIN_NAME=System Administrator
AUTH_ALLOW_LEGACY_TOKEN=1
REQUIRE_PATIENT_AUTH=0
CORS_ORIGINS=http://localhost:5173
OUTBOX_WORKER_ENABLED=1
OUTBOX_POLL_SECONDS=10
# `stub` logs delivery for the local demo. Production validation requires `fcm`.
NOTIFICATION_CHANNEL=stub
# FIREBASE_CREDENTIALS=C:\secure\firebase-service-account.json
# Alternatively use GOOGLE_APPLICATION_CREDENTIALS / workload identity.
LOG_FORMAT=text

# Production minimums:
# APP_ENV=production
# AUTH_ALLOW_LEGACY_TOKEN=0
# REQUIRE_PATIENT_AUTH=1
# CORS_ORIGINS=https://your-dashboard.example
# RATE_LIMIT_REQUESTS=120
# RATE_LIMIT_WINDOW_SECONDS=60
# NOTIFICATION_CHANNEL=fcm
# The process refuses to start when production secrets/CORS are unsafe.

# Production Firebase credentials must stay outside the repository. Either use
# an absolute path to a protected service-account JSON file or configure
# GOOGLE_APPLICATION_CREDENTIALS / workload identity on the VPS.
