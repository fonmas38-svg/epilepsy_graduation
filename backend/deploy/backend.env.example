APP_ENV=production
SQLITE_DB_PATH=/opt/epilepsy/backend/data/epilepsy.db
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=System Administrator
AUTH_ALLOW_LEGACY_TOKEN=0
REQUIRE_PATIENT_AUTH=1
CORS_ORIGINS=https://dashboard.example.com
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=2097152
OUTBOX_WORKER_ENABLED=1
OUTBOX_POLL_SECONDS=10
NOTIFICATION_CHANNEL=fcm
FIREBASE_CREDENTIALS=/etc/epilepsy-api/firebase-service-account.json
LOG_FORMAT=json
LOG_LEVEL=INFO