rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return userDoc().role;
    }

    function isPatient(patientId) {
      return signedIn() && request.auth.uid == patientId;
    }

    function isLinkedCaregiver(patientId) {
      return signedIn()
        && role() == 'caregiver'
        && patientId in userDoc().linkedPatientIds;
    }

    function isLinkedDoctor(patientId) {
      return signedIn()
        && role() == 'doctor'
        && patientId in userDoc().linkedPatientIds;
    }

    function canAccessPatient(patientId) {
      return isPatient(patientId)
        || isLinkedCaregiver(patientId)
        || isLinkedDoctor(patientId);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || role() == 'doctor');
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId;
    }

    match /patients/{patientId} {
      allow read: if canAccessPatient(patientId);
      allow write: if isPatient(patientId) || isLinkedDoctor(patientId);
    }

    match /patients/{patientId}/readings/{readingId} {
      allow read: if canAccessPatient(patientId);
      allow create: if isPatient(patientId);
      allow update, delete: if isPatient(patientId) || isLinkedDoctor(patientId);
    }

    match /patients/{patientId}/assessments/{assessmentId} {
      allow read: if canAccessPatient(patientId);
      allow create: if isPatient(patientId) || isLinkedDoctor(patientId);
    }

    match /patients/{patientId}/alerts/{alertId} {
      allow read: if canAccessPatient(patientId);
      allow create: if isPatient(patientId) || isLinkedDoctor(patientId);
      allow update: if canAccessPatient(patientId);
    }
  }
}
