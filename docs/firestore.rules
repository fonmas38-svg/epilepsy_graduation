rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return userDoc().role;
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function isPatient(patientId) {
      return signedIn() && request.auth.uid == patientId;
    }

    function isLinkedCaregiver(patientId) {
      return signedIn()
        && role() == 'caregiver'
        && patientId in userDoc().linkedPatientIds;
    }

    function isLinkedDoctor(patientId) {
      return signedIn()
        && role() == 'doctor'
        && patientId in userDoc().linkedPatientIds;
    }

    function canAccessPatient(patientId) {
      return isAdmin()
        || isPatient(patientId)
        || isLinkedCaregiver(patientId)
        || isLinkedDoctor(patientId);
    }

    function isSafeSelfProfileUpdate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phone', 'fcmToken']);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      // Identity, role, status, and patient links are server-owned. Firebase
      // Admin SDK bypasses rules; untrusted clients may only edit profile fields.
      allow create, delete: if false;
      allow update: if isSafeSelfProfileUpdate(userId);
    }

    match /patients/{patientId} {
      allow read: if canAccessPatient(patientId);
      allow write: if false;
    }

    match /patients/{patientId}/readings/{readingId} {
      allow read: if canAccessPatient(patientId);
      allow write: if false;
    }

    match /patients/{patientId}/assessments/{assessmentId} {
      allow read: if canAccessPatient(patientId);
      allow write: if false;
    }

    match /patients/{patientId}/alerts/{alertId} {
      allow read: if canAccessPatient(patientId);
      allow write: if false;
    }

    // Deny any collection not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
